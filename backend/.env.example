# Environment Configuration for AAYAM Backend Prototype
APP_NAME=AAYAM Infrastructure Intelligence API
ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./aayam_infra.db

# Authentication & Session Security
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Optional Evidence-Grounded LLM Provider Configuration
# Set one of the following API keys to enable live LLM answer synthesis in the AI Decision Copilot.
# If no key is set, the Copilot automatically operates in deterministic retrieval-only fallback mode.

# Option 1: Google Gemini (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Option 2: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 3: Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Option 4: Testing & Offline Evaluation Mode (values: test_mock)
# LLM_PROVIDER=test_mock
